  "scripting": {
    "code": "import pandas as pd\nimport pulp\n\n# 1. Load Data\ncsv_path = \"/Users/christopherliebl/Documents/OTH/6.Semester/KI-Projekt/texprompter/data/optimization_pipeline_test_easy.csv\"\ndf = pd.read_csv(csv_path)\n\n# 2. Define Index Set and Parameters\nP = df['Product_ID'].tolist()\npi_p = dict(zip(df['Product_ID'], df['Profit_Per_Unit']))\na_p = dict(zip(df['Product_ID'], df['Machine_A_Hours_Req']))\nb_p = dict(zip(df['Product_ID'], df['Machine_B_Hours_Req']))\nl_p = dict(zip(df['Product_ID'], df['Labor_Hours_Req']))\nr_p = dict(zip(df['Product_ID'], df['Raw_Material_Units_Req']))\nm_p = dict(zip(df['Product_ID'], df['Min_Production_Requirement']))\nd_p = dict(zip(df['Product_ID'], df['Max_Market_Demand']))\n\n# RHS Constants\nRHS_A = 1800.0\nRHS_B = 2200.0\nRHS_L = 3500.0\nRHS_R = 10000.0\n\n# 3. Create Problem\nprob = pulp.LpProblem(\"Production_Optimization\", pulp.LpMaximize)\n\n# 4. Decision Variables\nx = pulp.LpVariable.dicts(\"x\", P, lowBound=0, cat='Continuous')\n\n# 5. Objective Function\nprob += pulp.lpSum([pi_p[p] * x[p] for p in P]), \"Maximize_Profit\"\n\n# 6. Constraints\nprob += pulp.lpSum([a_p[p] * x[p] for p in P]) <= RHS_A, \"Machine_A_Limit\"\nprob += pulp.lpSum([b_p[p] * x[p] for p in P]) <= RHS_B, \"Machine_B_Limit\"\nprob += pulp.lpSum([l_p[p] * x[p] for p in P]) <= RHS_L, \"Labor_Limit\"\nprob += pulp.lpSum([r_p[p] * x[p] for p in P]) <= RHS_R, \"Raw_Material_Limit\"\n\n# Bounds: m_p <= x_p <= d_p\nfor p in P:\n    x[p].lowBound = m_p[p]\n    x[p].upBound = d_p[p]\n\n# 7. Solve\nprob.solve()\n\n# 8. Extract Results\ndecision_variables = {p: x[p].varValue for p in P}\nobjective_value = pulp.value(prob.objective)\nsolution_status = pulp.LpStatus[prob.status]\nsolver_message = str(prob.status)\n\n# Output payload\noutput = {\n    \"decision_variables\": decision_variables,\n    \"objective_value\": objective_value,\n    \"solution_status\": solution_status,\n    \"solver_message\": solver_message\n}",
    "output_schema": {
