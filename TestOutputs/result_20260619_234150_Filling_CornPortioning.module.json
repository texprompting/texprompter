    "scripting": {
      "code": "import pandas as pd\nimport pulp\nimport os\n\ndef solve_model(csv_path: str) -> dict:\n    # Load the data\n    if not os.path.exists(csv_path):\n        raise FileNotFoundError(f\"The file {csv_path} does not exist.\")\n        \n    df = pd.read_csv(csv_path)\n    \n    # The optimization horizon is fixed at T = 100 time steps\n    T = 100\n    if len(df) < T:\n        T = len(df)\n        \n    # Define parameters from the mathematical model\n    E_fwd = 5.0\n    E_rev = 4.0\n    E_slow = 2.0\n    W = 0.1\n    R_fwd = 0.1\n    R_slow = 0.05\n    P_target = 4.0\n    \n    # Initialize the optimization problem\n    model = pulp.LpProblem(\"Portioner_Optimization\", pulp.LpMinimize)\n    \n    # Decision variables\n    x_fwd = pulp.LpVariable.dicts(\"x_fwd\", range(1, T + 1), cat=pulp.LpBinary)\n    x_rev = pulp.LpVariable.dicts(\"x_rev\", range(1, T + 1), cat=pulp.LpBinary)\n    x_slow = pulp.LpVariable.dicts(\"x_slow\", range(1, T + 1), cat=pulp.LpBinary)\n    u = pulp.LpVariable.dicts(\"u\", range(1, T + 1), cat=pulp.LpBinary)\n    \n    # Objective function\n    model += pulp.lpSum(\n        E_fwd * x_fwd[t] + E_rev * x_rev[t] + E_slow * x_slow[t] + W * t * u[t]\n        for t in range(1, T + 1)\n    ), \"Total_Cost\"\n    \n    # Constraints\n    # 1. At most one mode can be active at any time step t\n    for t in range(1, T + 1):\n        model += x_fwd[t] + x_rev[t] + x_slow[t] <= 1, f\"Single_Mode_Constraint_{t}\"\n        \n    # 2. Active state indicator u_t must be 1 if any mode is active\n    for t in range(1, T + 1):\n        model += u[t] >= x_fwd[t] + x_rev[t] + x_slow[t], f\"Active_State_Constraint_{t}\"\n        \n    # 3. Total portion production must meet or exceed the target\n    model += pulp.lpSum(\n        R_fwd * x_fwd[t] + R_slow * x_slow[t] for t in range(1, T + 1)\n    ) >= P_target, \"Production_Target_Constraint\"\n    \n    # 4. Transition constraint: cannot switch directly from forward to reverse\n    for t in range(1, T):\n        model += x_fwd[t] + x_rev[t+1] <= 1, f\"Transition_Constraint_{t}\"\n        \n    # Solve the model\n    status = model.solve(pulp.PULP_CBC_CMD(msg=False))\n    \n    # Extract results\n    solution_status = pulp.LpStatus[status]\n    objective_value = pulp.value(model.objective) if solution_status == \"Optimal\" else None\n    \n    decision_variables = {}\n    for t in range(1, T + 1):\n        decision_variables[f\"x_fwd_{t}\"] = float(x_fwd[t].varValue) if x_fwd[t].varValue is not None else 0.0\n        decision_variables[f\"x_rev_{t}\"] = float(x_rev[t].varValue) if x_rev[t].varValue is not None else 0.0\n        decision_variables[f\"x_slow_{t}\"] = float(x_slow[t].varValue) if x_slow[t].varValue is not None else 0.0\n        decision_variables[f\"u_{t}\"] = float(u[t].varValue) if u[t].varValue is not None else 0.0\n        \n    return {\n        \"solution_status\": solution_status,\n        \"objective_value\": objective_value,\n        \"decision_variables\": decision_variables,\n        \"solver_message\": f\"Optimization completed with status: {solution_status}\"\n    }\n\nif __name__ == \"__main__\":\n    # Default path for testing\n    csv_path = \"/var/folders/yl/x3_zrbc16q18h23q2t01c0lr0000gn/T/tmps91xxa_b.csv\"\n    if os.path.exists(csv_path):\n        results = solve_model(csv_path)\n        print(\"Status:\", results[\"solution_status\"])\n        print(\"Objective Value:\", results[\"objective_value\"])\n",
