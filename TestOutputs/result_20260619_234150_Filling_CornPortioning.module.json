      "mapper_script": "import pandas as pd\nimport os\n\ndef prepare_data():\n    # Path to the CSV file\n    csv_path = \"tmpsvy922y0.csv\"\n    if not os.path.exists(csv_path):\n        csv_path = \"/var/folders/yl/x3_zrbc16q18h23q2t01c0lr0000gn/T/tmpsvy922y0.csv\"\n\n    # Load the data\n    df = pd.read_csv(csv_path)\n\n    # Since the mathematical model specifies T = 100, we take the first 100 rows\n    T = 100\n    df_subset = df.head(T).copy()\n\n    # Create the set of time steps (1-based index)\n    time_steps = list(range(1, T + 1))\n\n    # Extract timestamps as a dictionary indexed by time step\n    timestamps = {t: int(df_subset.iloc[t-1]['Timestamp']) for t in time_steps}\n\n    # Define parameters from the mathematical model\n    E_fwd = 5.0\n    E_rev = 4.0\n    E_slow = 2.0\n    W = 0.1\n    R_fwd = 0.1\n    R_slow = 0.05\n    P_target = 4.0\n\n    # Package data for optimization\n    data = {\n        'T': T,\n        'time_steps': time_steps,\n        'timestamps': timestamps,\n        'E_fwd': E_fwd,\n        'E_rev': E_rev,\n        'E_slow': E_slow,\n        'W': W,\n        'R_fwd': R_fwd,\n        'R_slow': R_slow,\n        'P_target': P_target\n    }\n    \n    return data\n\nif __name__ == \"__main__\":\n    data = prepare_data()\n    print(\"Data preparation completed successfully.\")\n    print(f\"Number of time steps: {data['T']}\")",
