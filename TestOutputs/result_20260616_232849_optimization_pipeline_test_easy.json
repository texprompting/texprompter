    "scripting": {
      "code": "import pandas as pd\nimport pulp\n\n# Load data\ndf = pd.read_csv('/var/folders/yl/x3_zrbc16q18h23q2t01c0lr0000gn/T/tmp5rlwluhm.csv')\n\n# Define index set P\nP = df['Product_ID'].tolist()\n\n# Define parameters as dictionaries mapping product ID to value\npi_p = dict(zip(df['Product_ID'], df['Profit_Per_Unit']))\na_pA = dict(zip(df['Product_ID'], df['Machine_A_Hours_Req']))\na_pB = dict(zip(df['Product_ID'], df['Machine_B_Hours_Req']))\nl_p = dict(zip(df['Product_ID'], df['Labor_Hours_Req']))\nr_p = dict(zip(df['Product_ID'], df['Raw_Material_Units_Req']))\nL_p = dict(zip(df['Product_ID'], df['Min_Production_Requirement']))\nU_p = dict(zip(df['Product_ID'], df['Max_Market_Demand']))\n\n# Fixed resource capacities from problem statement\ncapacity_A = 11000.0\ncapacity_B = 13000.0\ncapacity_L = 21600.0\ncapacity_R = 65000.0\n\n# Create the problem\nprob = pulp.LpProblem(\"Production_Planning\", pulp.LpMaximize)\n\n# Decision variables\nx = pulp.LpVariable.dicts(\"x\", P, lowBound=0, cat=pulp.LpInteger)\n\n# Apply bounds from data\nfor p in P:\n    x[p].lowBound = L_p[p]\n    x[p].upBound = U_p[p]\n\n# Objective function\nprob += pulp.lpSum([pi_p[p] * x[p] for p in P])\n\n# Constraints\nprob += pulp.lpSum([a_pA[p] * x[p] for p in P]) <= capacity_A\nprob += pulp.lpSum([a_pB[p] * x[p] for p in P]) <= capacity_B\nprob += pulp.lpSum([l_p[p] * x[p] for p in P]) <= capacity_L\nprob += pulp.lpSum([r_p[p] * x[p] for p in P]) <= capacity_R\n\n# Solve\nprob.solve(pulp.PULP_CBC_CMD(msg=0))\n\n# Extract results\ndecision_variables = {p: float(x[p].varValue) if x[p].varValue is not None else 0.0 for p in P}\nobjective_value = float(pulp.value(prob.objective)) if pulp.value(prob.objective) is not None else 0.0\nsolution_status = pulp.LpStatus[prob.status]\nsolver_message = str(prob.message)\n\n# Format output according to requested schema\noutput = {\n    \"decision_variables\": decision_variables,\n    \"objective_value\": objective_value,\n    \"solution_status\": solution_status,\n    \"solver_message\": solver_message\n}",
