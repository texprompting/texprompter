      "mapper_script": "import pandas as pd\n\n# Load the dataset\ndf = pd.read_csv('tmpj8jb1028.csv')\n\n# Define the set of products\nP = df['Product_ID'].tolist()\n\n# Define parameters as dictionaries mapping Product_ID to values\nProfit = df.set_index('Product_ID')['Profit_Per_Unit'].to_dict()\nA = df.set_index('Product_ID')['Machine_A_Hours_Req'].to_dict()\nB = df.set_index('Product_ID')['Machine_B_Hours_Req'].to_dict()\nL = df.set_index('Product_ID')['Labor_Hours_Req'].to_dict()\nM = df.set_index('Product_ID')['Raw_Material_Units_Req'].to_dict()\nMin = df.set_index('Product_ID')['Min_Production_Requirement'].to_dict()\nMax = df.set_index('Product_ID')['Max_Market_Demand'].to_dict()\n\n# Define capacity constants\nCap_A = 10000\nCap_B = 12000\nCap_L = 20000\nCap_M = 60000",
