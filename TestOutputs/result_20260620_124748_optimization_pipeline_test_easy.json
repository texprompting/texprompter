    "scripting": {
      "code": "import pandas as pd\nimport pulp\nfrom typing import Any\n\ndef solve_model(csv_path: str) -> dict[str, Any]:\n    # Load the CSV file\n    df = pd.read_csv(csv_path)\n    \n    # Extract the set of products\n    P = df['Product_ID'].tolist()\n    \n    # Extract parameters as dictionaries indexed by Product_ID\n    Profit = df.set_index('Product_ID')['Profit_Per_Unit'].to_dict()\n    MachA_Req = df.set_index('Product_ID')['Machine_A_Hours_Req'].to_dict()\n    MachB_Req = df.set_index('Product_ID')['Machine_B_Hours_Req'].to_dict()\n    Labor_Req = df.set_index('Product_ID')['Labor_Hours_Req'].to_dict()\n    Mat_Req = df.set_index('Product_ID')['Raw_Material_Units_Req'].to_dict()\n    MinProd = df.set_index('Product_ID')['Min_Production_Requirement'].to_dict()\n    MaxDem = df.set_index('Product_ID')['Max_Market_Demand'].to_dict()\n    \n    # Capacities\n    Cap_A = 10000\n    Cap_B = 12000\n    Cap_Labor = 20000\n    Cap_Mat = 60000\n    \n    # Define the LP problem\n    prob = pulp.LpProblem(\"Maximize_Profit\", pulp.LpMaximize)\n    \n    # Decision variables\n    x = {}\n    for p in P:\n        x[p] = pulp.LpVariable(\n            name=f\"x_{p}\",\n            lowBound=MinProd[p],\n            upBound=MaxDem[p],\n            cat=pulp.LpContinuous\n        )\n        \n    # Objective function\n    prob += pulp.lpSum(Profit[p] * x[p] for p in P), \"Total_Profit\"\n    \n    # Constraints\n    prob += pulp.lpSum(MachA_Req[p] * x[p] for p in P) <= Cap_A, \"Cap_A\"\n    prob += pulp.lpSum(MachB_Req[p] * x[p] for p in P) <= Cap_B, \"Cap_B\"\n    prob += pulp.lpSum(Labor_Req[p] * x[p] for p in P) <= Cap_Labor, \"Cap_Labor\"\n    prob += pulp.lpSum(Mat_Req[p] * x[p] for p in P) <= Cap_Mat, \"Cap_Mat\"\n    \n    # Solve the model\n    status = prob.solve(pulp.PULP_CBC_CMD(msg=False))\n    \n    # Prepare results\n    solution_status = pulp.LpStatus[status]\n    objective_value = pulp.value(prob.objective) if solution_status == \"Optimal\" else None\n    \n    decision_variables = {}\n    for p in P:\n        decision_variables[f\"x_{p}\"] = pulp.value(x[p])\n        \n    return {\n        \"solution_status\": solution_status,\n        \"objective_value\": objective_value,\n        \"decision_variables\": decision_variables,\n        \"solver_message\": f\"Solver finished with status: {solution_status}\"\n    }\n\nif __name__ == \"__main__\":\n    # Default path from context for testing\n    csv_path = \"/var/folders/yl/x3_zrbc16q18h23q2t01c0lr0000gn/T/tmp0fo5dyt7.csv\"\n    try:\n        results = solve_model(csv_path)\n        print(\"Status:\", results[\"solution_status\"])\n        print(\"Objective Value:\", results[\"objective_value\"])\n    except Exception as e:\n        print(\"Error running solver:\", e)\n",
