      "mapper_script": "import pandas as pd\n\n# Load the dataset\ncsv_path = '/var/folders/yl/x3_zrbc16q18h23q2t01c0lr0000gn/T/tmp2k647c99.csv'\ndf = pd.read_csv(csv_path)\n\n# Clean data\ndf = df.dropna(subset=['Product_SKU'])\ndf = df.drop_duplicates(subset=['Product_SKU'])\n\n# Define sets\nP = df['Product_SKU'].tolist()\n\n# Define parameters\nS = df.set_index('Product_SKU')['Sale_Price_Per_Unit'].to_dict()\nC = df.set_index('Product_SKU')['Material_Cost_Per_Unit'].to_dict()\nM = df.set_index('Product_SKU')['Molding_Mins_Req'].to_dict()\nA = df.set_index('Product_SKU')['Assembly_Mins_Req'].to_dict()\nD = df.set_index('Product_SKU')['Max_Market_Capacity'].to_dict()\n\n# Constants\nC_mold = 500000\nC_assembly = 400000",
      "mapping_notes": [
