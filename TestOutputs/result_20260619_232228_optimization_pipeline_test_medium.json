    "scripting": {
      "code": "import pandas as pd\nimport pulp\nfrom typing import Any, Dict\n\ndef solve_model(csv_path: str) -> Dict[str, Any]:\n    # Load the dataset\n    df = pd.read_csv(csv_path)\n\n    # Clean data\n    df = df.dropna(subset=['Product_SKU'])\n    df = df.drop_duplicates(subset=['Product_SKU'])\n\n    # Define sets\n    P = df['Product_SKU'].tolist()\n\n    # Define parameters\n    S = df.set_index('Product_SKU')['Sale_Price_Per_Unit'].to_dict()\n    C = df.set_index('Product_SKU')['Material_Cost_Per_Unit'].to_dict()\n    M = df.set_index('Product_SKU')['Molding_Mins_Req'].to_dict()\n    A = df.set_index('Product_SKU')['Assembly_Mins_Req'].to_dict()\n    D = df.set_index('Product_SKU')['Max_Market_Capacity'].to_dict()\n\n    # Constants\n    C_mold = 500000\n    C_assembly = 400000\n\n    # Define the problem\n    prob = pulp.LpProblem(\"Product_Mix_Optimization\", pulp.LpMaximize)\n\n    # Decision variables\n    x = {p: pulp.LpVariable(f\"x_{p}\", lowBound=0, upBound=D[p], cat='Continuous') for p in P}\n\n    # Objective function\n    prob += pulp.lpSum((S[p] - C[p]) * x[p] for p in P), \"Total_Profit\"\n\n    # Constraints\n    prob += pulp.lpSum(M[p] * x[p] for p in P) <= C_mold, \"Molding_Capacity\"\n    prob += pulp.lpSum(A[p] * x[p] for p in P) <= C_assembly, \"Assembly_Capacity\"\n\n    # Solve the problem\n    status = prob.solve(pulp.PULP_CBC_CMD(msg=False))\n\n    # Prepare results\n    solution_status = pulp.LpStatus[status]\n    objective_value = pulp.value(prob.objective) if solution_status == \"Optimal\" else None\n    decision_variables = {f\"x_{p}\": pulp.value(x[p]) for p in P}\n\n    return {\n        \"solution_status\": solution_status,\n        \"objective_value\": objective_value,\n        \"decision_variables\": decision_variables,\n        \"solver_message\": f\"Solver finished with status: {solution_status}\"\n    }\n\nif __name__ == \"__main__\":\n    # Default path for testing\n    csv_path = \"/var/folders/yl/x3_zrbc16q18h23q2t01c0lr0000gn/T/tmp9pu29eav.csv\"\n    try:\n        results = solve_model(csv_path)\n        print(\"Status:\", results[\"solution_status\"])\n        print(\"Objective Value:\", results[\"objective_value\"])\n    except Exception as e:\n        print(\"Error running solver:\", e)\n",
