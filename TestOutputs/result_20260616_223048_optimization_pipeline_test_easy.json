    "scripting": {
      "code": "import pandas as pd\nimport pulp\n\n# Load data\ndf = pd.read_csv('/var/folders/yl/x3_zrbc16q18h23q2t01c0lr0000gn/T/tmp8uqk54kz.csv')\n\n# Define index set\nP = df['Product_ID'].tolist()\n\n# Define parameters\npi_i = dict(zip(df['Product_ID'], df['Profit_Per_Unit']))\na_i = dict(zip(df['Product_ID'], df['Machine_A_Hours_Req']))\nb_i = dict(zip(df['Product_ID'], df['Machine_B_Hours_Req']))\nl_i = dict(zip(df['Product_ID'], df['Labor_Hours_Req']))\nr_i = dict(zip(df['Product_ID'], df['Raw_Material_Units_Req']))\nL_i = dict(zip(df['Product_ID'], df['Min_Production_Requirement']))\nU_i = dict(zip(df['Product_ID'], df['Max_Market_Demand']))\n\n# Resource capacities\nCAPACITY_A = 85.0\nCAPACITY_B = 100.0\nCAPACITY_L = 165.0\nCAPACITY_R = 500.0\n\n# Create the problem\nprob = pulp.LpProblem(\"Production_Planning\", pulp.LpMaximize)\n\n# Decision variables\nx = pulp.LpVariable.dicts(\"x\", P, lowBound=0, cat=pulp.LpInteger)\n\n# Objective function\nprob += pulp.lpSum([pi_i[i] * x[i] for i in P])\n\n# Resource constraints\nprob += pulp.lpSum([a_i[i] * x[i] for i in P]) <= CAPACITY_A\nprob += pulp.lpSum([b_i[i] * x[i] for i in P]) <= CAPACITY_B\nprob += pulp.lpSum([l_i[i] * x[i] for i in P]) <= CAPACITY_L\nprob += pulp.lpSum([r_i[i] * x[i] for i in P]) <= CAPACITY_R\n\n# Apply per-product lower and upper bounds\nfor i in P:\n    x[i].lowBound = L_i[i]\n    x[i].upBound = U_i[i]\n\n# Solve\nprob.solve()\n\n# Extract results according to requested schema\nresult = {\n    \"decision_variables\": {i: x[i].varValue for i in P},\n    \"objective_value\": float(pulp.value(prob.objective)) if pulp.value(prob.objective) is not None else 0.0,\n    \"solution_status\": pulp.LpStatus[prob.status],\n    \"solver_message\": pulp.LpStatus[prob.status]\n}",
      "output_schema": {
        "decision_variables": "dict[str, float]",
        "objective_value": "float",
        "solution_status": "str",
        "solver_message": "str"
