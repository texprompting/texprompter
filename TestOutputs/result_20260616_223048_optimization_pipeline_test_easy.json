      "mapper_script": "import pandas as pd\n\n# Load data\ndf = pd.read_csv('tmp8uqk54kz.csv')\n\n# Define index set\nP = df['Product_ID'].tolist()\n\n# Define parameters\npi_i = dict(zip(df['Product_ID'], df['Profit_Per_Unit']))\na_i = dict(zip(df['Product_ID'], df['Machine_A_Hours_Req']))\nb_i = dict(zip(df['Product_ID'], df['Machine_B_Hours_Req']))\nl_i = dict(zip(df['Product_ID'], df['Labor_Hours_Req']))\nr_i = dict(zip(df['Product_ID'], df['Raw_Material_Units_Req']))\nL_i = dict(zip(df['Product_ID'], df['Min_Production_Requirement']))\nU_i = dict(zip(df['Product_ID'], df['Max_Market_Demand']))\n\n# Resource capacities\nCAPACITY_A = 85.0\nCAPACITY_B = 100.0\nCAPACITY_L = 165.0\nCAPACITY_R = 500.0",
      "mapping_notes": [
