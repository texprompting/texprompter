    "scripting": {
      "code": "import pandas as pd\nimport pulp\nfrom typing import Any, Dict\n\ndef solve_model(csv_path: str) -> Dict[str, Any]:\n    # Load the dataset\n    df = pd.read_csv(csv_path)\n\n    # Preprocessing: Ensure Product_SKU is unique and drop any rows with missing critical values\n    critical_cols = [\n        'Product_SKU', \n        'Sale_Price_Per_Unit', \n        'Material_Cost_Per_Unit', \n        'Molding_Mins_Req', \n        'Assembly_Mins_Req', \n        'Max_Market_Capacity'\n    ]\n    df = df.dropna(subset=critical_cols)\n    df = df.drop_duplicates(subset=['Product_SKU'])\n\n    # Define sets\n    P = df['Product_SKU'].tolist()\n\n    # Define parameters\n    S = df.set_index('Product_SKU')['Sale_Price_Per_Unit'].to_dict()\n    C = df.set_index('Product_SKU')['Material_Cost_Per_Unit'].to_dict()\n    M = df.set_index('Product_SKU')['Molding_Mins_Req'].to_dict()\n    A = df.set_index('Product_SKU')['Assembly_Mins_Req'].to_dict()\n    D = df.set_index('Product_SKU')['Max_Market_Capacity'].to_dict()\n\n    # Capacities\n    T_molding = 200000\n    T_assembly = 200000\n\n    # Initialize the problem\n    prob = pulp.LpProblem(\"Product_Mix_Optimization\", pulp.LpMaximize)\n\n    # Decision variables: x_p >= 0 and x_p <= D_p\n    x = {p: pulp.LpVariable(f\"x_{p}\", lowBound=0, upBound=D[p], cat=pulp.LpContinuous) for p in P}\n\n    # Objective function: Maximize total profit\n    prob += pulp.lpSum((S[p] - C[p]) * x[p] for p in P), \"Total_Profit\"\n\n    # Constraints\n    prob += pulp.lpSum(M[p] * x[p] for p in P) <= T_molding, \"Molding_Capacity_Constraint\"\n    prob += pulp.lpSum(A[p] * x[p] for p in P) <= T_assembly, \"Assembly_Capacity_Constraint\"\n\n    # Solve the model\n    status = prob.solve(pulp.PULP_CBC_CMD(msg=False))\n\n    # Prepare results\n    solution_status = pulp.LpStatus[status]\n    objective_value = pulp.value(prob.objective) if solution_status == \"Optimal\" else None\n    \n    decision_variables = {f\"x_{p}\": x[p].varValue for p in P}\n\n    return {\n        \"solution_status\": solution_status,\n        \"objective_value\": objective_value,\n        \"decision_variables\": decision_variables,\n        \"solver_message\": f\"Optimization completed with status: {solution_status}\"\n    }\n\nif __name__ == \"__main__\":\n    # Example execution with the default path\n    import os\n    csv_file_path = \"/var/folders/yl/x3_zrbc16q18h23q2t01c0lr0000gn/T/tmp22l7wh_k.csv\"\n    if os.path.exists(csv_file_path):\n        results = solve_model(csv_file_path)\n        print(\"Status:\", results[\"solution_status\"])\n        print(\"Objective Value:\", results[\"objective_value\"])\n",
