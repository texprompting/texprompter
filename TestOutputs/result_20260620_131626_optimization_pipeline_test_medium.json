      "mapper_script": "import pandas as pd\n\n# Load the dataset\ndf = pd.read_csv('tmpgf0kge_u.csv')\n\n# Preprocessing: Ensure Product_SKU is unique and drop any rows with missing critical values\ndf = df.dropna(subset=['Product_SKU', 'Sale_Price_Per_Unit', 'Material_Cost_Per_Unit', 'Molding_Mins_Req', 'Assembly_Mins_Req', 'Max_Market_Capacity'])\ndf = df.drop_duplicates(subset=['Product_SKU'])\n\n# Define sets\nP = df['Product_SKU'].tolist()\n\n# Define parameters\nS = df.set_index('Product_SKU')['Sale_Price_Per_Unit'].to_dict()\nC = df.set_index('Product_SKU')['Material_Cost_Per_Unit'].to_dict()\nM = df.set_index('Product_SKU')['Molding_Mins_Req'].to_dict()\nA = df.set_index('Product_SKU')['Assembly_Mins_Req'].to_dict()\nD = df.set_index('Product_SKU')['Max_Market_Capacity'].to_dict()\n\n# Capacities\nT_molding = 200000\nT_assembly = 200000",
