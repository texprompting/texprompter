      "mapper_script": "import pandas as pd\n\n# Load the data\ncsv_path = \"/var/folders/yl/x3_zrbc16q18h23q2t01c0lr0000gn/T/tmpnko0nrkc.csv\"\ndf = pd.read_csv(csv_path)\n\n# Define sets\nP = df['Product_ID'].tolist()\n\n# Define parameters\nProfit = dict(zip(df['Product_ID'], df['Profit_Per_Unit']))\nReqA = dict(zip(df['Product_ID'], df['Machine_A_Hours_Req']))\nReqB = dict(zip(df['Product_ID'], df['Machine_B_Hours_Req']))\nReqL = dict(zip(df['Product_ID'], df['Labor_Hours_Req']))\nReqR = dict(zip(df['Product_ID'], df['Raw_Material_Units_Req']))\nMinProd = dict(zip(df['Product_ID'], df['Min_Production_Requirement']))\nMaxDem = dict(zip(df['Product_ID'], df['Max_Market_Demand']))\n\n# Capacities\nCapA = 7000\nCapB = 8000\nCapL = 14000\nCapR = 40000",
