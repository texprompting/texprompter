    "scripting": {
      "code": "import pandas as pd\nimport pulp\nfrom typing import Dict, Any\n\ndef solve_model(csv_path: str) -> Dict[str, Any]:\n    \"\"\"\n    Solves the production planning optimization problem.\n    \n    Args:\n        csv_path (str): Path to the CSV file containing product data.\n        \n    Returns:\n        dict: A dictionary containing the solution status, objective value,\n              decision variables, and solver message.\n    \"\"\"\n    # Load the data\n    df = pd.read_csv(csv_path)\n    \n    # Define sets\n    P = df['Product_ID'].tolist()\n    \n    # Define parameters\n    Profit = dict(zip(df['Product_ID'], df['Profit_Per_Unit']))\n    ReqA = dict(zip(df['Product_ID'], df['Machine_A_Hours_Req']))\n    ReqB = dict(zip(df['Product_ID'], df['Machine_B_Hours_Req']))\n    ReqL = dict(zip(df['Product_ID'], df['Labor_Hours_Req']))\n    ReqR = dict(zip(df['Product_ID'], df['Raw_Material_Units_Req']))\n    MinProd = dict(zip(df['Product_ID'], df['Min_Production_Requirement']))\n    MaxDem = dict(zip(df['Product_ID'], df['Max_Market_Demand']))\n    \n    # Capacities\n    CapA = 7000\n    CapB = 8000\n    CapL = 14000\n    CapR = 40000\n    \n    # Initialize model\n    prob = pulp.LpProblem(\"Maximize_Profit\", pulp.LpMaximize)\n    \n    # Decision variables\n    x = {p: pulp.LpVariable(f\"x_{p}\", lowBound=MinProd[p], upBound=MaxDem[p], cat='Continuous') for p in P}\n    \n    # Objective function\n    prob += pulp.lpSum(Profit[p] * x[p] for p in P), \"Total_Profit\"\n    \n    # Constraints\n    prob += pulp.lpSum(ReqA[p] * x[p] for p in P) <= CapA, \"Machine_A_Capacity\"\n    prob += pulp.lpSum(ReqB[p] * x[p] for p in P) <= CapB, \"Machine_B_Capacity\"\n    prob += pulp.lpSum(ReqL[p] * x[p] for p in P) <= CapL, \"Labor_Capacity\"\n    prob += pulp.lpSum(ReqR[p] * x[p] for p in P) <= CapR, \"Raw_Material_Capacity\"\n    \n    # Solve\n    status = prob.solve(pulp.PULP_CBC_CMD(msg=False))\n    \n    # Results\n    solution_status = pulp.LpStatus[status]\n    objective_value = pulp.value(prob.objective)\n    decision_variables = {f\"x_{p}\": pulp.value(x[p]) for p in P}\n    \n    return {\n        \"solution_status\": solution_status,\n        \"objective_value\": objective_value,\n        \"decision_variables\": decision_variables,\n        \"solver_message\": f\"Optimization status: {solution_status}\"\n    }\n\nif __name__ == \"__main__\":\n    # Default path from context for testing\n    default_csv_path = \"/var/folders/yl/x3_zrbc16q18h23q2t01c0lr0000gn/T/tmpnko0nrkc.csv\"\n    try:\n        results = solve_model(default_csv_path)\n        print(\"Status:\", results[\"solution_status\"])\n        print(\"Objective Value:\", results[\"objective_value\"])\n    except Exception as e:\n        print(\"Error running default execution:\", e)\n",
