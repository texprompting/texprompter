    "scripting": {
      "code": "import pandas as pd\nimport pulp\n\n# Load data\ndf = pd.read_csv('/var/folders/yl/x3_zrbc16q18h23q2t01c0lr0000gn/T/tmprgt10umx.csv')\n\n# Define index set\nP = df['Product_ID'].tolist()\n\n# Define parameters as dictionaries\nc_i = dict(zip(df['Product_ID'], df['Profit_Per_Unit']))\na_A_i = dict(zip(df['Product_ID'], df['Machine_A_Hours_Req']))\na_B_i = dict(zip(df['Product_ID'], df['Machine_B_Hours_Req']))\nl_i = dict(zip(df['Product_ID'], df['Labor_Hours_Req']))\nr_i = dict(zip(df['Product_ID'], df['Raw_Material_Units_Req']))\nL_i = dict(zip(df['Product_ID'], df['Min_Production_Requirement']))\nD_i = dict(zip(df['Product_ID'], df['Max_Market_Demand']))\n\n# Resource capacities\nCAP_A = 13000.0\nCAP_B = 15000.0\nCAP_L = 20000.0\nCAP_R = 50000.0\n\n# Create the problem\nprob = pulp.LpProblem(\"Production_Planning\", pulp.LpMaximize)\n\n# Decision variables\nx = pulp.LpVariable.dicts(\"x\", P, lowBound=0, cat=pulp.LpInteger)\n\n# Objective function\nprob += pulp.lpSum([c_i[i] * x[i] for i in P])\n\n# Constraints\nprob += pulp.lpSum([a_A_i[i] * x[i] for i in P]) <= CAP_A\nprob += pulp.lpSum([a_B_i[i] * x[i] for i in P]) <= CAP_B\nprob += pulp.lpSum([l_i[i] * x[i] for i in P]) <= CAP_L\nprob += pulp.lpSum([r_i[i] * x[i] for i in P]) <= CAP_R\n\nfor i in P:\n    prob += x[i] >= L_i[i]\n    prob += x[i] <= D_i[i]\n\n# Solve\nprob.solve()\n\n# Extract results\ndecision_variables = {i: x[i].varValue for i in P}\nobjective_value = float(pulp.value(prob.objective))\nsolution_status = pulp.LpStatus[prob.status]\nsolver_message = str(prob)\n\n# Output schema\noutput = {\n    \"decision_variables\": decision_variables,\n    \"objective_value\": objective_value,\n    \"solution_status\": solution_status,\n    \"solver_message\": solver_message\n}",
      "output_schema": {
