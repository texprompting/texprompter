      "mapper_script": "import pandas as pd\n\n# Load data\ndf = pd.read_csv('tmprgt10umx.csv')\n\n# Define index set\nP = df['Product_ID'].tolist()\n\n# Define parameters as dictionaries\nc_i = dict(zip(df['Product_ID'], df['Profit_Per_Unit']))\na_A_i = dict(zip(df['Product_ID'], df['Machine_A_Hours_Req']))\na_B_i = dict(zip(df['Product_ID'], df['Machine_B_Hours_Req']))\nl_i = dict(zip(df['Product_ID'], df['Labor_Hours_Req']))\nr_i = dict(zip(df['Product_ID'], df['Raw_Material_Units_Req']))\nL_i = dict(zip(df['Product_ID'], df['Min_Production_Requirement']))\nD_i = dict(zip(df['Product_ID'], df['Max_Market_Demand']))\n\n# Resource capacities\nCAP_A = 13000.0\nCAP_B = 15000.0\nCAP_L = 20000.0\nCAP_R = 50000.0",
