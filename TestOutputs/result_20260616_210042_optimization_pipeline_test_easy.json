    "scripting": {
      "code": "import pandas as pd\nimport pulp\n\n# Load CSV data\ncsv_path = \"/var/folders/yl/x3_zrbc16q18h23q2t01c0lr0000gn/T/tmpyacfihx8.csv\"\ndf = pd.read_csv(csv_path)\n\n# Extract index set I from Product_ID\nI = df['Product_ID'].tolist()\n\n# Create parameter dictionaries as per preprocessing mapper\nP_i = dict(zip(df['Product_ID'], df['Profit_Per_Unit']))\nM_A_i = dict(zip(df['Product_ID'], df['Machine_A_Hours_Req']))\nM_B_i = dict(zip(df['Product_ID'], df['Machine_B_Hours_Req']))\nL_i = dict(zip(df['Product_ID'], df['Labor_Hours_Req']))\nR_i = dict(zip(df['Product_ID'], df['Raw_Material_Units_Req']))\nlb_i = dict(zip(df['Product_ID'], df['Min_Production_Requirement']))\nub_i = dict(zip(df['Product_ID'], df['Max_Market_Demand']))\n\n# Define the optimization problem\nprob = pulp.LpProblem(\"Production_Planning_MILP\", pulp.LpMaximize)\n\n# Decision variables: x_i for each product i in I\n# Integer variables as per x_i \\in \\mathbb{Z}_{\\ge 0}\nx = pulp.LpVariable.dicts(\"x\", I, lowBound=0, upBound=None, cat='Integer')\n\n# Objective function: max \\sum_{i \\in I} 47.03 x_i\nprob += pulp.lpSum([47.03 * x[i] for i in I])\n\n# Constraints from mathematical model\nprob += pulp.lpSum([1.71 * x[i] for i in I]) <= 15500.0\nprob += pulp.lpSum([2.01 * x[i] for i in I]) <= 18000.0\nprob += pulp.lpSum([3.34 * x[i] for i in I]) <= 30000.0\nprob += pulp.lpSum([10.08 * x[i] for i in I]) <= 90000.0\n\n# Apply bounds from mathematical model: 5.8 \\le x_i \\le 258.78\nfor i in I:\n    x[i].lowBound = 5.8\n    x[i].upBound = 258.78\n\n# Solve the problem\nprob.solve(pulp.PULP_CBC_CMD(msg=0))\n\n# Extract results into the requested output schema\ndecision_variables = {i: pulp.value(x[i]) for i in I}\nobjective_value = pulp.value(prob.objective)\nsolution_status = pulp.LpStatus[prob.status]\nsolver_message = str(prob.message)\n\noutput = {\n    \"decision_variables\": decision_variables,\n    \"objective_value\": objective_value,\n    \"solution_status\": solution_status,\n    \"solver_message\": solver_message\n}\n\nprint(output)",
