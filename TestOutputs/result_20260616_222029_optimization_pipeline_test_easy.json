    "scripting": {
      "code": "import pandas as pd\nimport pulp\n\n# Load data\ndf = pd.read_csv('/var/folders/yl/x3_zrbc16q18h23q2t01c0lr0000gn/T/tmpzuj7gt7_.csv')\n\n# Define set P\nP = df['Product_ID'].tolist()\n\n# Define parameters\np_i = dict(zip(df['Product_ID'], df['Profit_Per_Unit']))\na_i = dict(zip(df['Product_ID'], df['Machine_A_Hours_Req']))\nb_i = dict(zip(df['Product_ID'], df['Machine_B_Hours_Req']))\nl_i = dict(zip(df['Product_ID'], df['Labor_Hours_Req']))\nr_i = dict(zip(df['Product_ID'], df['Raw_Material_Units_Req']))\nmin_i = dict(zip(df['Product_ID'], df['Min_Production_Requirement']))\nmax_i = dict(zip(df['Product_ID'], df['Max_Market_Demand']))\n\n# Create the problem\nprob = pulp.LpProblem(\"Production_Planning\", pulp.LpMaximize)\n\n# Create decision variables\nx = pulp.LpVariable.dicts(\"x\", P, lowBound=0, upBound=None, cat=pulp.LpInteger)\n\n# Objective function\nprob += pulp.lpSum([p_i[i] * x[i] for i in P])\n\n# Constraints\nprob += pulp.lpSum([a_i[i] * x[i] for i in P]) <= 22140.0, \"Machine_A_Capacity\"\nprob += pulp.lpSum([b_i[i] * x[i] for i in P]) <= 25980.0, \"Machine_B_Capacity\"\nprob += pulp.lpSum([l_i[i] * x[i] for i in P]) <= 43240.0, \"Labor_Capacity\"\nprob += pulp.lpSum([r_i[i] * x[i] for i in P]) <= 130200.0, \"Raw_Material_Capacity\"\n\n# Apply lower and upper bounds for each variable\nfor i in P:\n    x[i].lowBound = min_i[i]\n    x[i].upBound = max_i[i]\n\n# Solve\nprob.solve()\n\n# Extract results\ndecision_variables = {i: x[i].varValue for i in P}\nobjective_value = pulp.value(prob.objective)\nsolution_status = pulp.LpStatus[prob.status]\nsolver_message = str(prob.message)\n\n# Output payload\noutput = {\n    \"decision_variables\": decision_variables,\n    \"objective_value\": objective_value,\n    \"solution_status\": solution_status,\n    \"solver_message\": solver_message\n}",
      "output_schema": {
