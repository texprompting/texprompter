    "scripting": {
      "code": "import pandas as pd\nimport pulp\n\n# Load data\ndf = pd.read_csv('/var/folders/yl/x3_zrbc16q18h23q2t01c0lr0000gn/T/tmpea2rnmoq.csv')\n\n# Define index set\nP = df['Product_ID'].tolist()\n\n# Define parameters as dictionaries\npi = dict(zip(df['Product_ID'], df['Profit_Per_Unit']))\na_A = dict(zip(df['Product_ID'], df['Machine_A_Hours_Req']))\na_B = dict(zip(df['Product_ID'], df['Machine_B_Hours_Req']))\nl = dict(zip(df['Product_ID'], df['Labor_Hours_Req']))\nr = dict(zip(df['Product_ID'], df['Raw_Material_Units_Req']))\nL = dict(zip(df['Product_ID'], df['Min_Production_Requirement']))\nD = dict(zip(df['Product_ID'], df['Max_Market_Demand']))\n\n# Resource capacities\nCAPACITY_A = 85.55\nCAPACITY_B = 100.36\nCAPACITY_L = 167.11\nCAPACITY_R = 504.0\n\n# Create the problem\nprob = pulp.LpProblem(\"Production_Planning\", pulp.LpMaximize)\n\n# Decision variables\nx = pulp.LpVariable.dicts(\"Prod\", P, lowBound=0, cat='Integer')\n\n# Objective function\nprob += pulp.lpSum([pi[p] * x[p] for p in P])\n\n# Constraints\nprob += pulp.lpSum([a_A[p] * x[p] for p in P]) <= CAPACITY_A\nprob += pulp.lpSum([a_B[p] * x[p] for p in P]) <= CAPACITY_B\nprob += pulp.lpSum([l[p] * x[p] for p in P]) <= CAPACITY_L\nprob += pulp.lpSum([r[p] * x[p] for p in P]) <= CAPACITY_R\n\n# Bounds for each variable\nfor p in P:\n    x[p].lowBound = L[p]\n    x[p].upBound = D[p]\n\n# Solve\nprob.solve(pulp.PULP_CBC_CMD(msg=0))\n\n# Extract results\ndecision_variables = {p: float(x[p].varValue) if x[p].varValue is not None else None for p in P}\nobjective_value = pulp.value(prob.objective)\nsolution_status = pulp.LpStatus[prob.status]\nsolver_message = pulp.LpStatus[prob.status]\n\n# Output schema\noutput = {\n    \"decision_variables\": decision_variables,\n    \"objective_value\": objective_value,\n    \"solution_status\": solution_status,\n    \"solver_message\": solver_message\n}",
      "output_schema": {
        "decision_variables": "dict[str, float]",
